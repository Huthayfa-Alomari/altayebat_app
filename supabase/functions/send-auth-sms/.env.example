# Supabase Send SMS Auth Hook secret generated in Authentication > Hooks
SEND_SMS_HOOK_SECRET=v1,whsec_REPLACE_ME

# SMS provider transport
SMS_PROVIDER_URL=https://provider.example.com/api/messages
SMS_PROVIDER_METHOD=POST
SMS_PROVIDER_BODY_FORMAT=json
SMS_PROVIDER_API_KEY=REPLACE_ME
SMS_PROVIDER_AUTH_HEADER=Authorization
SMS_PROVIDER_AUTH_SCHEME=Bearer

# Altayebat defaults
SMS_SENDER_ID=Altayebat
SMS_ALLOWED_PHONE_PREFIX=+9627
SMS_MESSAGE_TEMPLATE=رمز التحقق لأسواق الطيبات: {{otp}}. لا تشارك الرمز مع أحد.

# Default field mapping
SMS_FIELD_TO=to
SMS_FIELD_MESSAGE=message
SMS_FIELD_SENDER=sender

# Optional alternatives:
# SMS_PROVIDER_PAYLOAD_TEMPLATE={"mobile":"{{phone}}","text":"{{message}}","from":"{{sender}}"}
# SMS_PROVIDER_HEADERS_JSON={"Accept":"application/json"}
